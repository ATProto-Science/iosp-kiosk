{
  "name": "iosp-kiosk-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Real database_id is filled in at deploy time (`wrangler d1 create iosp-kiosk`).
  "d1_databases": [{ "binding": "DB", "database_name": "iosp-kiosk", "database_id": "00000000-0000-0000-0000-000000000000" }]
  // Secret (never committed): ADMIN_TOKEN — `wrangler secret put ADMIN_TOKEN`.
  // Route (added at deploy): kiosk.tilde.style/api/*
}
